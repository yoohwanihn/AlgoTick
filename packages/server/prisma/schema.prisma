// AlgoTick Prisma Schema - Stage 1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Market {
  US
  KR
  JP
}

enum Exchange {
  NASDAQ
  NYSE
  AMEX
  OTC
  KOSPI
  KOSDAQ
  KONEX
  TSE
  TSE_STANDARD
  TSE_GROWTH
}

model Ticker {
  symbol      String    @id
  market      Market
  exchange    Exchange
  nameEn      String?
  nameKo      String?
  sector      String?
  industry    String?
  currency    String
  listedAt    DateTime?
  delistedAt  DateTime?
  // profile fields (nullable):
  description String?
  weburl      String?
  logo        String?
  phone       String?
  ipo         DateTime?
  country     String?
  // DART fields:
  // 우선주 등은 동일 회사라 같은 corp_code를 공유하므로 @unique 두지 않음 (1 corpCode : N ticker).
  dartCorpCode  String?
  ceoName       String?
  foundedDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  quotesIntraday       QuoteIntraday[]
  quotesDaily          QuoteDaily[]
  financials           Financial[]
  news                 News[]
  insiderTrades        InsiderTrade[]
  institutionalHoldings InstitutionalHolding[]
  watchlist            Watchlist?
  portfolioLots        PortfolioLot[]

  @@index([market])
  @@index([exchange])
  @@map("tickers")
}

model QuoteIntraday {
  symbol     String
  ts         DateTime
  price      Decimal  @db.Decimal(20, 6)
  volume     BigInt
  changePct  Decimal  @db.Decimal(10, 4)
  source     String

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, ts])
  @@index([ts])
  @@map("quotes_intraday")
}

model QuoteDaily {
  symbol    String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(20, 6)
  high      Decimal  @db.Decimal(20, 6)
  low       Decimal  @db.Decimal(20, 6)
  close     Decimal  @db.Decimal(20, 6)
  adjClose  Decimal? @db.Decimal(20, 6)
  volume    BigInt

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, date])
  @@index([symbol, date(sort: Desc)])
  @@map("quotes_daily")
}

model IngestionLog {
  symbol         String
  kind           String   // "quote" | "daily" | "financials" | ...
  lastFetchedAt  DateTime

  @@id([symbol, kind])
  @@map("ingestion_log")
}

model Financial {
  symbol      String
  period      String   // "202312" (annual) or "2025Q1" (quarterly)
  periodType  String   // "A" (annual) or "Q" (quarterly)
  asOf        DateTime // period 마감일
  source      String   // "naver" / "finnhub" / "sec" / etc.
  data        Json     // 모든 재무 항목 (revenue, op_income, net_income, roe, per, pbr, ...)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, period])
  @@index([symbol, asOf(sort: Desc)])
  @@map("financials")
}

model News {
  id           String   @id @default(uuid())
  symbol       String?
  scope        String   // "ticker" | "market"
  market       String?  // "US" | "KR" — only when scope="market" or to filter by market
  publishedAt  DateTime
  title        String
  source       String?
  url          String
  summary      String?
  externalId   String?  // upsert key (Naver articleId, Finnhub id)
  createdAt    DateTime @default(now())

  ticker Ticker? @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, publishedAt(sort: Desc)])
  @@index([scope, market, publishedAt(sort: Desc)])
  @@unique([symbol, externalId])
  @@map("news_items")
}

model InsiderTrade {
  id              String    @id @default(uuid())
  symbol          String
  externalId      String
  tradeDate       DateTime
  filingDate      DateTime?
  personName      String
  role            String?
  side            String
  shares          BigInt
  price           Decimal?  @db.Decimal(20, 6)
  transactionCode String?
  source          String
  isDerivative    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, externalId])
  @@index([symbol, tradeDate(sort: Desc)])
  @@map("insider_trades")
}

model Watchlist {
  symbol     String   @id
  addedAt    DateTime @default(now())
  memo       String?
  position   Int      @default(0)  // 정렬 순서

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([position])
  @@map("watchlist")
}

model PortfolioLot {
  id        String   @id @default(uuid())
  symbol    String
  side      String   // "BUY" | "SELL"
  qty       Decimal  @db.Decimal(20, 6)   // 소수 지원 (split-adjusted)
  price     Decimal  @db.Decimal(20, 6)
  tradedAt  DateTime
  note      String?
  createdAt DateTime @default(now())

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, tradedAt(sort: Desc)])
  @@map("portfolio_lots")
}

model InstitutionalHolding {
  id             String   @id @default(uuid())
  symbol         String
  externalId     String   // upsert key (rcept_no or composite)
  holderName     String   // 보고자
  reportDate     DateTime // rcept_dt
  shares         BigInt   // stkqy
  pctOfFloat     Decimal? @db.Decimal(8, 4)  // stkrt (지분율 %)
  prevShares     BigInt?  // bsis_pstn_stkqy
  prevPctOfFloat Decimal? @db.Decimal(8, 4)
  source         String   // "dart" / "sec"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, externalId])
  @@index([symbol, reportDate(sort: Desc)])
  @@map("institutional_holdings")
}

model ValidationResult {
  id        String   @id @default(uuid())
  symbol    String
  kind      String   // "quote" | "daily" | "financials" | ...
  ts        DateTime @default(now())
  severity  String   // "error" | "warning" | "info"
  code      String   // "MARKET_CAP_MISMATCH" | "OHLC_INVARIANT" | ...
  message   String
  details   Json?

  @@index([symbol, ts(sort: Desc)])
  @@index([severity, ts(sort: Desc)])
  @@map("validation_results")
}

model ScreenerRule {
  id         String   @id @default(uuid())
  name       String
  conditions Json     // [{field, op, value}, ...]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("screener_rules")
}

model MarketIndex {
  code      String   @id  // "^GSPC", "^KS11", "^VIX", "KRW=X"
  name      String       // "S&P 500"
  market    String       // "US" | "KR" | "GLOBAL"
  kind      String       // "index" | "volatility" | "fx"
  position  Int      @default(0)

  quotesIntraday IndexQuoteIntraday[]
  quotesDaily    IndexQuoteDaily[]

  @@map("indices")
}

model IndexQuoteIntraday {
  code      String
  ts        DateTime
  value     Decimal  @db.Decimal(20, 6)
  changePct Decimal  @db.Decimal(10, 4)
  source    String

  index MarketIndex @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([code, ts])
  @@index([ts])
  @@map("index_quotes_intraday")
}

model IndexQuoteDaily {
  code   String
  date   DateTime @db.Date
  open   Decimal? @db.Decimal(20, 6)
  high   Decimal? @db.Decimal(20, 6)
  low    Decimal? @db.Decimal(20, 6)
  close  Decimal  @db.Decimal(20, 6)

  index MarketIndex @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([code, date])
  @@index([code, date(sort: Desc)])
  @@map("index_quotes_daily")
}

model MarketEvent {
  id        String   @id @default(uuid())
  eventDate DateTime
  market    String   // "US" | "KR" | "GLOBAL"
  kind      String   // "earnings" | "economic"
  symbol    String?  // for earnings
  title     String
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([eventDate, market, kind, symbol, title])
  @@index([eventDate])
  @@map("market_events")
}
