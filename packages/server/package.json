    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "p-limit": "^5.0.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "undici": "^6.19.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
